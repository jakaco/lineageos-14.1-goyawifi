# SPDX-License-Identifier: Apache-2.0
on boot
    chown system system /sys/class/input/input4/enable
    chmod 0660 /sys/class/input/input4/enable
    chown system system /sys/class/input/input4/poll_delay
    chmod 0660 /sys/class/input/input4/poll_delay
    write /sys/class/input/input4/poll_delay 66

# RAM-only framework bring-up. Services stay disabled until files, permissions
# and volatile data directories have been staged and checked through root ADB.
on init
    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export ANDROID_STORAGE /storage
    export ASEC_MOUNTPOINT /mnt/asec
    export EXTERNAL_STORAGE /storage/emulated/0
    export BOOTCLASSPATH /system/framework/core-oj.jar:/system/framework/core-libart.jar:/system/framework/conscrypt.jar:/system/framework/okhttp.jar:/system/framework/core-junit.jar:/system/framework/bouncycastle.jar:/system/framework/ext.jar:/system/framework/framework.jar:/system/framework/telephony-common.jar:/system/framework/voip-common.jar:/system/framework/ims-common.jar:/system/framework/apache-xml.jar:/system/framework/org.apache.http.legacy.boot.jar:/system/framework/telephony-ext.jar
    export SYSTEMSERVERCLASSPATH /system/framework/org.cyanogenmod.platform.jar:/system/framework/org.cyanogenmod.hardware.jar:/system/framework/services.jar:/system/framework/ethernet-service.jar:/system/framework/wifi-service.jar

on property:goyawifi.runtime.ready=1
    load_persist_props
    start lmkd
    start logd
    start debuggerd
    start servicemanager
    start healthd
    start installd
    start vold
    start netd
    start surfaceflinger
    start audioserver
    start mediaextractor
    start mediacodec
    start drmserver
    start media
    start cameraserver
    start keystore
    start gatekeeperd

on property:goyawifi.framework.ready=1
    start bootanim
    start zygote

service logd /system/bin/logd
    class core
    socket logd stream 0666 logd logd
    socket logdr seqpacket 0666 logd logd
    socket logdw dgram 0222 logd logd
    group root system readproc
    disabled

service debuggerd /system/bin/debuggerd
    class core
    group root readproc
    disabled

service servicemanager /system/bin/servicemanager
    class core
    user system
    group system readproc
    disabled

service healthd /system/bin/healthd
    class core
    user root
    group root system wakelock
    disabled

service installd /system/bin/installd
    class core
    socket installd stream 0600 system system
    disabled

service netd /system/bin/netd
    class main
    socket netd stream 0660 root system
    socket dnsproxyd stream 0660 root inet
    socket mdns stream 0660 root system
    socket fwmarkd stream 0660 root inet
    disabled

# fstab.pxa988 contains only the RAM /data entry and no voldmanaged disks.
service vold /system/bin/vold --blkid_context=u:r:blkid:s0 --blkid_untrusted_context=u:r:blkid_untrusted:s0 --fsck_context=u:r:fsck:s0 --fsck_untrusted_context=u:r:fsck_untrusted:s0
    class core
    socket vold stream 0660 root mount
    socket cryptd stream 0660 root mount
    disabled

service surfaceflinger /system/bin/surfaceflinger
    class core
    user root
    group root graphics drmrpc readproc
    setenv LD_LIBRARY_PATH /system/lib:/system/lib/egl
    setenv LD_PRELOAD /system/lib/libshim_goyawifi_binder.so
    disabled

# Source-built generic stub audio for framework boot; Marvell audio is unported.
service audioserver /system/bin/audioserver
    class main
    user audioserver
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct
    disabled

service media /system/bin/mediaserver
    setenv LD_PRELOAD /system/lib/libshim_goyawifi_binder.so
    class main
    user media
    group audio camera inet net_bt net_bt_admin net_bw_acct drmrpc mediadrm
    disabled

service keystore /system/bin/keystore /data/misc/keystore
    class main
    user keystore
    group keystore drmrpc readproc
    disabled

service gatekeeperd /system/bin/gatekeeperd /data/misc/gatekeeper
    class main
    user system
    group system
    disabled

service bootanim /system/bin/bootanimation
    class main
    user graphics
    group graphics audio
    setenv LD_LIBRARY_PATH /system/lib:/system/lib/egl
    setenv LD_PRELOAD /system/lib/libshim_goyawifi_binder.so
    disabled
    oneshot

service zygote /system/bin/app_process32 -Xzygote -Xnoimage-dex2oat /system/bin --zygote --start-system-server --socket-name=zygote
    class main
    socket zygote stream 0660 root system
    user root
    group root readproc
    setenv LD_LIBRARY_PATH /system/lib:/system/lib/egl
    setenv LD_PRELOAD /system/lib/libshim_goyawifi_binder.so
    disabled

service cameraserver /system/bin/cameraserver
    class main
    setenv LD_LIBRARY_PATH /system/lib:/system/lib/egl
    setenv LD_PRELOAD /system/lib/libshim_goyawifi_binder.so
    user cameraserver
    group camera graphics audio media readproc
    disabled

# The Wi-Fi framework starts/stops this service through ctl properties.
service wpa_supplicant /system/bin/wpa_supplicant -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -e/data/misc/wifi/entropy.bin -O/data/misc/wifi/sockets -g@android:wpa_wlan0
    class main
    user root
    group root wifi inet keystore
    socket wpa_wlan0 dgram 0660 wifi wifi
    disabled
    oneshot

service lmkd /system/bin/lmkd
    class core
    user root
    group root
    socket lmkd seqpacket 0660 system system
    disabled

on property:sys.boot_completed=1
    start goyafirstboot

service goyafirstboot /sbin/busybox sh /sbin/internal-firstboot.sh
    user root
    group root
    disabled
    oneshot

service mediaextractor /system/bin/mediaextractor
    class main
    user mediaex
    group drmrpc mediadrm
    disabled

service mediacodec /system/bin/mediacodec
    class main
    user mediacodec
    group camera drmrpc mediadrm
    disabled

service drmserver /system/bin/drmserver
    class main
    user drm
    group drmrpc mediadrm
    disabled
