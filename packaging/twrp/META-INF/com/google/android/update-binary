#!/sbin/sh
# SPDX-License-Identifier: Apache-2.0
# LineageOS 14.1 installer for the Galaxy Tab 3 Lite 7.0 (SM-T110, goyawifi).
# Writes SYSTEM and KERNEL, verifies both, and leaves RECOVERY and DATA alone.
OUTFD="$2"
ZIPFILE="$3"
BB=/sbin/busybox
SYSTEM=/dev/block/mmcblk0p15
KERNEL=/dev/block/mmcblk0p10
BYNAME=/dev/block/platform/sdhci-pxav3.2/by-name
RELEASE=r6
SYSTEM_GZ_SHA=00a8311e14b9de268fdecc7c9d96fcce9a60badb686daa5010b1822c0e33a721
SYSTEM_RAW_SHA=64afac41301abc55d581d36e80f06aafacffbfd9dea4b17a45294fd466cee1de
KERNEL_SHA=b50cebfcf895843ac10c0e9840b4e3d3e889f2de6c9cc77b1a3a6ceae158bf45

ui_print() {
    echo "ui_print $*" >&$OUTFD
    echo "ui_print" >&$OUTFD
}
# Advance the progress bar by FRACTION, animated over SECONDS.
progress() { echo "progress $1 $2" >&$OUTFD; }
set_progress() { echo "set_progress $1" >&$OUTFD; }
abort() {
    ui_print " "
    ui_print "! $*"
    ui_print "! Nothing was written."
    exit 1
}
fail() {
    ui_print " "
    ui_print "! $*"
    ui_print "! Don't reboot: restore your backup or flash again."
    exit 1
}
sha() { "$BB" sha256sum | cut -d' ' -f1; }

ui_print " "
ui_print "LineageOS 14.1 | $RELEASE"
ui_print "Galaxy Tab 3 Lite 7.0"
ui_print " "
set_progress 0

# Device ------------------------------------------------------------------
ui_print "- Checking device"
[ -x "$BB" ] || abort "TWRP BusyBox is missing"
MODEL="$(getprop ro.product.model)"
DEVICE="$(getprop ro.product.device)"
# TWRP builds report the SM-T110 as goyawifi or goya. The SM-T111 (goya3g) is the same
# board with a modem. The SM-T210/T211 (lt02) share the chip but are wired differently, so
# this kernel can't drive them; the T113/T116/T217 use other chips. The partition checks
# below are the real gate.
case "$MODEL" in
    SM-T110*) VARIANT=t110 ;;
    SM-T111*) VARIANT=t111 ;;
    SM-T21*) abort "The $MODEL (Galaxy Tab 3 7.0) is wired differently and isn't supported" ;;
    SM-T113*|SM-T116*|SM-T217*) abort "The $MODEL uses a different chip and isn't supported" ;;
    *)
        case "$DEVICE" in
            goyawifi|goya) VARIANT=t110 ;;
            goya3g) VARIANT=t111 ;;
            lt02*) abort "The Galaxy Tab 3 7.0 ($DEVICE) is wired differently and isn't supported" ;;
            *) abort "This zip is for the Galaxy Tab 3 Lite 7.0 (found ${MODEL:-?}, ${DEVICE:-?})" ;;
        esac
        ;;
esac
case "$VARIANT" in
    t111)
        ui_print " "
        ui_print "! ${MODEL:-$DEVICE} (3G) detected. This build is"
        ui_print "! for Wi-Fi models: calls, SMS and mobile"
        ui_print "! data won't work. Not tested on this model."
        ui_print " "
        ;;
esac
[ "$("$BB" readlink $BYNAME/SYSTEM)" = "$SYSTEM" ] || abort "Unexpected partition layout (SYSTEM)"
[ "$("$BB" readlink $BYNAME/KERNEL)" = "$KERNEL" ] || abort "Unexpected partition layout (KERNEL)"
[ "$(blockdev --getsize64 "$SYSTEM")" = "1594884096" ] || abort "Unexpected SYSTEM size"
[ "$(blockdev --getsize64 "$KERNEL")" = "16777216" ] || abort "Unexpected KERNEL size"
set_progress 0.02

# Package ------------------------------------------------------------------
ui_print "- Verifying package"
progress 0.10 45
[ "$("$BB" unzip -p "$ZIPFILE" system.ext4.gz | sha)" = "$SYSTEM_GZ_SHA" ] || abort "Package is damaged (system), download it again"
[ "$("$BB" unzip -p "$ZIPFILE" kernel-partition.img | sha)" = "$KERNEL_SHA" ] || abort "Package is damaged (kernel), download it again"
set_progress 0.12

# System -------------------------------------------------------------------
grep -q " /system " /proc/mounts && { umount /system || abort "Could not unmount /system"; }
ui_print "- Flashing system (about 5 minutes)"
progress 0.63 300
"$BB" unzip -p "$ZIPFILE" system.ext4.gz | "$BB" gzip -dc > "$SYSTEM" || fail "Writing system failed"
sync
set_progress 0.75
ui_print "- Verifying system"
progress 0.15 80
if [ "$(sha < "$SYSTEM")" != "$SYSTEM_RAW_SHA" ]; then
    ui_print "  Verification failed, flashing system again"
    "$BB" unzip -p "$ZIPFILE" system.ext4.gz | "$BB" gzip -dc > "$SYSTEM" || fail "Writing system failed"
    sync
    [ "$(sha < "$SYSTEM")" = "$SYSTEM_RAW_SHA" ] || fail "System verification failed twice"
fi
set_progress 0.92

# Kernel -------------------------------------------------------------------
ui_print "- Flashing kernel"
"$BB" unzip -p "$ZIPFILE" kernel-partition.img | dd of="$KERNEL" bs=1048576 2>/dev/null || fail "Writing kernel failed"
sync
[ "$(sha < "$KERNEL")" = "$KERNEL_SHA" ] || fail "Kernel verification failed"
set_progress 1

ui_print "- Done"
ui_print " "
ui_print "Google apps and root (addonsu) go on now, before rebooting."
ui_print " "
exit 0
