<?xml version="1.0" encoding="utf-8"?>
<MediaCodecs>
    <Decoders>
        <MediaCodec name="OMX.MARVELL.VIDEO.HW.CODA7542DECODER" type="video/avc">
            <Quirk name="requires-allocate-on-output-ports"/>
            <Limit name="size" min="176x144" max="1280x720"/>
            <Limit name="alignment" value="2x2"/>
            <Limit name="block-size" value="16x16"/>
            <Limit name="block-count" range="99-3600"/>
            <Limit name="blocks-per-second" range="99-108000"/>
            <Limit name="bitrate" range="64000-8000000"/>
        </MediaCodec>
    </Decoders>
    <Encoders>
        <MediaCodec name="OMX.MARVELL.VIDEO.HW.CODA7542ENCODER" type="video/avc">
            <Limit name="size" min="176x144" max="640x480"/>
            <Limit name="alignment" value="16x16"/>
            <Limit name="block-size" value="16x16"/>
            <Limit name="block-count" range="99-1200"/>
            <Limit name="blocks-per-second" range="99-36000"/>
            <Limit name="bitrate" range="64000-4000000"/>
        </MediaCodec>
    </Encoders>
    <Include href="media_codecs_google_audio.xml"/>
    <Include href="media_codecs_google_video.xml"/>
</MediaCodecs>
