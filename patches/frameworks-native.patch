+#ifdef GOYAWIFI_HWC_LAYER_STRIDE_100
+// The old HAL supplies no scanout-retirement fence. Delay recycling the old
+// target until the replacement has crossed vblank, without blocking GL work.
+class FramebufferSurface::GoyaRetireThread : public Thread {
+    FramebufferSurface* mOwner;
+    int mFd;
+    Mutex mJobMutex;
+    Condition mJobReady;
+    Vector<GoyaRetiredBuffer> mJobs;
+    bool threadLoop() override {
+        Vector<GoyaRetiredBuffer> jobs;
+        {
+            Mutex::Autolock lock(mJobMutex);
+            while (mJobs.isEmpty() && !exitPending()) mJobReady.wait(mJobMutex);
+            if (exitPending()) return false;
+            jobs = mJobs;
+            mJobs.clear();
+        }
+        nsecs_t start = systemTime(SYSTEM_TIME_MONOTONIC);
+        // Exact downstream ABI: _IO('m',18), SYNC_SELF=0.
+        int result = ioctl(mFd, _IO('m',18), 0);
+        nsecs_t elapsed = systemTime(SYSTEM_TIME_MONOTONIC)-start;
+        ALOGW_IF(result || elapsed>ms2ns(40),
+                "GOYA_RETIRE vblank result=%d elapsed_us=%lld",result,
+                (long long)(elapsed/1000));
+        {
+            Mutex::Autolock lock(mOwner->mMutex);
+            for (size_t i=0;i<jobs.size();++i) {
+                const GoyaRetiredBuffer& item=jobs[i];
+                status_t rc=mOwner->releaseBufferLocked(item.slot,item.buffer,
+                        EGL_NO_DISPLAY,EGL_NO_SYNC_KHR);
+                ALOGE_IF(rc<0,"GOYA_RETIRE release slot=%d status=%d",item.slot,rc);
+                --mOwner->mGoyaOutstandingRetire;
+                ++mOwner->mGoyaRetiredTotal;
+                mOwner->mGoyaRetireLastUs=elapsed/1000;
+                if(elapsed/1000>mOwner->mGoyaRetireMaxUs)mOwner->mGoyaRetireMaxUs=elapsed/1000;
+            }
+            mOwner->mGoyaRetireDone.broadcast();
+        }
+        return true;
+    }
+public:
+    explicit GoyaRetireThread(FramebufferSurface* owner)
+        : mOwner(owner),mFd(open("/dev/graphics/fb0",O_RDONLY|O_CLOEXEC)) {}
+    ~GoyaRetireThread() override { if(mFd>=0)close(mFd); }
+    bool available() const { return mFd>=0; }
+    void enqueue(const Vector<GoyaRetiredBuffer>& jobs) {
+        Mutex::Autolock lock(mJobMutex);mJobs.appendVector(jobs);mJobReady.signal();
+    }
+    void stop() {
+        requestExit();
+        { Mutex::Autolock lock(mJobMutex);mJobReady.signal(); }
+        requestExitAndWait();
+    }
+};
+#endif
+
+FramebufferSurface::~FramebufferSurface() {
+#ifdef GOYAWIFI_HWC_LAYER_STRIDE_100
+    if(mGoyaRetireThread!=nullptr)mGoyaRetireThread->stop();
+#endif
+}
